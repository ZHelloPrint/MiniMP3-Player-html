 height:4px;
 border-radius:4px;
 background:var(--accent);
}

.visualizer.playing .bar{
 animation:bounce .55s infinite alternate ease-in-out;
}

.bar:nth-child(1){animation-delay:-.4s}
.bar:nth-child(2){animation-delay:-.2s}
.bar:nth-child(3){animation-delay:-.1s}
.bar:nth-child(4){animation-delay:-.3s}
.bar:nth-child(5){animation-delay:-.15s}
.bar:nth-child(6){animation-delay:-.35s}
