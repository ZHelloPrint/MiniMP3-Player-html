 font-weight:800;
}

.album.dragging .drop{
 display:flex;
}

.song{
 padding:16px 4px 8px;
}

.song-name{
 font-size:18px;
 font-weight:800;
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis;
}

.song-artist{
 margin-top:3px;
 font-size:12px;
 color:var(--muted);
 white-space:nowrap;
 overflow:hidden;
 text-overflow:ellipsis;
}

.progress{
 width:100%;
 height:4px;
 appearance:none;
 background:#e8e2e766;
 border-radius:20px;
 cursor:pointer;
}

.progress::-webkit-slider-thumb{
 appearance:none;
 width:12px;
 height:12px;
 border-radius:50%;
 background:var(--accent);
}

.times{
 display:flex;
