/* ==========================================
   METADATA
========================================== */

function readMetadata(file){

 return new Promise(resolve=>{

  jsmediatags.read(file,{

   onSuccess(tag){

    const t=tag.tags;
    let art=null;

    if(t.picture){

     let binary="";

     for(
      let i=0;
      i<t.picture.data.length;
      i++
     ){

      binary+=String.fromCharCode(
       t.picture.data[i]
      );

     }

     art=
      `data:${t.picture.format};base64,`+
      btoa(binary);
    }

    resolve({

     id:crypto.randomUUID(),
     file:file,
     title:
      t.title||
      file.name.replace(/\.[^/.]+$/,""),
     artist:
      t.artist||
      "Unknown artist",
     album:
      t.album||
      "Unknown album",
     art:
      art||defaultArt()

    });

   },

   onError(){

    resolve({

     id:crypto.randomUUID(),
     file:file,
     title:
      file.name.replace(/\.[^/.]+$/,""),
     artist:"Unknown artist",
     album:"Unknown album",
     art:defaultArt()

    });

   }

  });

 });
}


