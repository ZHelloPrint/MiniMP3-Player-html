<script>
/* ==========================================
   ELEMENTS
========================================== */

const audio =
 document.getElementById("audio");

const fileInput =
 document.getElementById("fileInput");

const dropZone =
 document.getElementById("dropZone");

const albumArt =
 document.getElementById("albumArt");

const placeholder =
 document.getElementById("placeholder");

const songTitle =
 document.getElementById("songTitle");

const artist =
 document.getElementById("artist");

const status =
 document.getElementById("status");

const progress =
 document.getElementById("progress");

const currentTime =
 document.getElementById("currentTime");

const duration =
 document.getElementById("duration");

const playButton =
 document.getElementById("play");

const volume =
 document.getElementById("volume");

const libraryList =
 document.getElementById("libraryList");

const visualizer =
 document.getElementById("visualizer");

const mini =
 document.getElementById("mini");

const miniArt =
 document.getElementById("miniArt");

const miniTitle =
 document.getElementById("miniTitle");

const miniArtist =
 document.getElementById("miniArtist");

let tracks=[];
let currentIndex=-1;
let currentView="songs";
let shuffle=false;
let repeat=false;
let sleepTimeout=null;
let wheelAccumulator=0;

let favorites=
 JSON.parse(
  localStorage.getItem("pocketFavorites")||"[]"
 );

let recent=
 JSON.parse(
  localStorage.getItem("pocketRecent")||"[]"
 );


/* ==========================================
   INDEXED DB
========================================== */

const DB_NAME="PocketMusicDB";
const DB_VERSION=1;
const STORE="tracks";

let db=null;

function openDB(){

 return new Promise((resolve,reject)=>{

  const request=
   indexedDB.open(DB_NAME,DB_VERSION);

  request.onupgradeneeded=e=>{

   const database=e.target.result;

   if(!database.objectStoreNames.contains(STORE)){
    database.createObjectStore(
     STORE,
     {keyPath:"id"}
    );
   }

  };

  request.onsuccess=e=>{
   db=e.target.result;
   resolve(db);
  };

  request.onerror=()=>{
   reject(request.error);
  };

 });

}

function dbPut(track){

 if(!db)return;

 return new Promise(resolve=>{

  const transaction=
   db.transaction(STORE,"readwrite");

  const store=
   transaction.objectStore(STORE);

  store.put({
   id:track.id,
   file:track.file,
   title:track.title,
   artist:track.artist,
   album:track.album,
   art:track.art
  });

  transaction.oncomplete=resolve;
  transaction.onerror=resolve;

 });
}

function dbGetAll(){

 if(!db)
  return Promise.resolve([]);

 return new Promise(resolve=>{

  const request=
   db.transaction(STORE,"readonly")
   .objectStore(STORE)
   .getAll();

  request.onsuccess=()=>{
   resolve(request.result||[]);
  };

  request.onerror=()=>{
   resolve([]);
  };

 });
}

function dbDelete(id){

 if(!db)return;

 const transaction=
  db.transaction(STORE,"readwrite");

 transaction.objectStore(STORE).delete(id);
}

function dbClear(){

 if(!db)return;

 const transaction=
  db.transaction(STORE,"readwrite");

 transaction.objectStore(STORE).clear();
}


