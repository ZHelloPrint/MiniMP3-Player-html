<style>
*{box-sizing:border-box}

:root{
 --accent:#ff73aa;
 --accent2:#ff9bc3;
 --accentSoft:#ffe3ef;
 --bg:#f7f4f7;
 --device:#f0eef1;
 --screen:#fffafd;
 --text:#302a31;
 --muted:#9e959e;
}

body.dark{
 --accent:#ff80b5;
 --accent2:#c783ff;
 --accentSoft:#342533;
 --bg:#171519;
 --device:#29262b;
 --screen:#211e23;
 --text:#f5edf3;
 --muted:#aaa1aa;
}

body.lavender{
 --accent:#9a82ff;
 --accent2:#c6baff;
 --accentSoft:#eeeaff;
}

body.mint{
 --accent:#55cbb0;
 --accent2:#9ae9d5;
 --accentSoft:#ddf8f1;
}

body.y2k{
 --accent:#758cff;
 --accent2:#d6ddff;
 --accentSoft:#e7ebff;
}

body{
 margin:0;
 min-height:100vh;
 display:flex;
 align-items:center;
 justify-content:center;
 padding:20px;
 background:
 radial-gradient(circle at 15% 15%,var(--accentSoft),transparent 28%),
 radial-gradient(circle at 85% 85%,#ddd8ff55,transparent 30%),
 var(--bg);
 font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
 color:var(--text);
 transition:.3s;
}

body.booting>*{
 visibility:hidden;
}

.boot{
 position:fixed;
 inset:0;
 z-index:9999;
 display:flex;
 align-items:center;
 justify-content:center;
 flex-direction:column;
 background:var(--bg);
 color:var(--text);
}

.boot-logo{
 font-size:50px;
 animation:bootPulse 1s infinite alternate;
}

.boot-text{
 margin-top:12px;
 font-size:12px;
 font-weight:700;
}

@keyframes bootPulse{
 from{transform:scale(.9);opacity:.45}
 to{transform:scale(1);opacity:1}
}

.device{
 width:min(420px,96vw);
 padding:18px;
 border-radius:40px;
 background:linear-gradient(145deg,#fff,var(--device));
 border:1px solid #ffffffaa;
 box-shadow:
 0 35px 80px #4d3d5528,
 inset 0 1px 2px white;
 transition:.3s;
}

body.dark .device{
 background:linear-gradient(145deg,#302d32,#211f23);
 border-color:#ffffff12;
}

.speaker{
 width:55px;
 height:5px;
