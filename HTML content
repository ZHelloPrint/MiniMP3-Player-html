function renderLibrary(){

 libraryList.innerHTML="";

 let list=filteredTracks();

 if(currentView==="albums"){

  const albums=
   [...new Set(
    tracks.map(t=>t.album)
   )];

  albums.forEach(album=>{

   const first=
    tracks.find(t=>t.album===album);

   const count=
    tracks.filter(
     t=>t.album===album
    ).length;

   addLibraryRow(
    first.art,
    album,
    `${count} song${count===1?"":"s"}`,
    ()=>{
     const firstIndex=
      tracks.indexOf(first);

     loadTrack(firstIndex);
     audio.play();
    }
   );

  });

  if(!albums.length)
   showEmpty("No albums yet");

  return;
 }

 if(currentView==="artists"){

  const artists=
   [...new Set(
    tracks.map(t=>t.artist)
   )];

  artists.forEach(name=>{

   const first=
    tracks.find(t=>t.artist===name);

   const count=
    tracks.filter(
     t=>t.artist===name
    ).length;

   addLibraryRow(
    first.art,
    name,
    `${count} song${count===1?"":"s"}`,
    ()=>{
     currentView="songs";
     const filtered=
      tracks.filter(
       t=>t.artist===name
      );

     renderLibrary();

     if(filtered.length){

      const i=
       tracks.indexOf(filtered[0]);

      loadTrack(i);

     }
    }
   );

  });

  if(!artists.length)
   showEmpty("No artists yet");

  return;
 }

 list.forEach(
  (track)=>{
   addTrackRow(track);
  }
 );

 if(!list.length)
  showEmpty(
   currentView==="favorites"
   ?"No favorites yet"
   :"No music yet"
  );
