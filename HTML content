}

.status-left{
 display:flex;
 gap:8px;
 align-items:center;
}

.album{
 position:relative;
 width:100%;
 aspect-ratio:1;
 overflow:hidden;
 border-radius:20px;
 background:linear-gradient(135deg,var(--accentSoft),#ddd9ff);
 box-shadow:0 12px 25px #503c5a20;
}

.album img{
 width:100%;
 height:100%;
 object-fit:cover;
 display:none;
 animation:albumIn .35s ease;
}

@keyframes albumIn{
 from{opacity:0;transform:scale(.96)}
 to{opacity:1;transform:scale(1)}
}

.placeholder{
 position:absolute;
 inset:0;
 display:flex;
 align-items:center;
 justify-content:center;
 flex-direction:column;
 color:var(--muted);
}

.note{
 font-size:62px;
}

.placeholder small{
 font-size:11px;
}

.drop{
 position:absolute;
 inset:0;
 display:none;
 align-items:center;
 justify-content:center;
 background:#ffffffc9;
