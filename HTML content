function formatTime(seconds){

 if(!Number.isFinite(seconds))
  return "0:00";

 const m=Math.floor(seconds/60);

 const s=Math.floor(seconds%60)
  .toString()
  .padStart(2,"0");

 return `${m}:${s}`;
}

function updateClock(){

 const now=new Date();

 document.getElementById("clock")
  .textContent=
