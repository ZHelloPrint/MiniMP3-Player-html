}

.visualizer{
 height:22px;
 display:flex;
 align-items:flex-end;
 justify-content:center;
 gap:3px;
 margin:4px 0 8px;
 opacity:.25;
}

.visualizer.playing{
 opacity:1;
}

.bar{
